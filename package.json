{
  "name": "llmwarp",
  "version": "1.2.1",
  "description": "Local OpenAI-protocol router CLI for switching LLM API providers",
  "keywords": [
    "llm",
    "openai",
    "openai-compatible",
    "router",
    "proxy",
    "cli",
    "tui",
    "codex",
    "api-gateway"
  ],
  "license": "MIT",
  "author": "aungv <aung_v@163.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aung-v/llmwarp.git"
  },
  "homepage": "https://github.com/aung-v/llmwarp#readme",
  "bugs": {
    "url": "https://github.com/aung-v/llmwarp/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "bin": {
    "llmwarp": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "node --test --import tsx test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@inquirer/core": "^10.3.2",
    "@inquirer/prompts": "^7.2.0",
    "commander": "^12.1.0",
    "jsonc-parser": "^3.3.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
